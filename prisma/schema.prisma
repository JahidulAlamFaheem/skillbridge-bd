// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum Role {
  CANDIDATE
  EMPLOYER
  ADMIN
}

enum ProjectKind {
  PROJECT
  PORTFOLIO
}

enum ExperienceLevel {
  INTERN
  ENTRY
  JUNIOR
  MID
  SENIOR
}

enum JobType {
  FULL_TIME
  PART_TIME
  INTERNSHIP
  CONTRACT
}

enum WorkArrangement {
  ONSITE
  REMOTE
  HYBRID
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
  REMOVED
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  SHORTLISTED
  REJECTED
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
}

enum ReportOutcome {
  NO_ACTION
  WARNING
  REMOVAL
}

// ---------- Users ----------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  createdAt    DateTime @default(now())

  candidateProfile CandidateProfile?
  organization     Organization?
  statusChanges    ApplicationStatusHistory[]
  reportsFiled     Report[]                   @relation("ReportReporter")
  reportsReviewed  Report[]                   @relation("ReportReviewer")
}

// ---------- Candidate side ----------

model CandidateProfile {
  id       String   @id @default(cuid())
  userId   String   @unique
  headline String
  bio      String
  location String
  phone    String?
  links    String[]

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills       CandidateSkill[]
  projects     Project[]
  applications Application[]
}

model Skill {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  aliases         SkillAlias[]
  candidateSkills CandidateSkill[]
  jobSkills       JobSkill[]
}

model SkillAlias {
  id      String @id @default(cuid())
  alias   String @unique
  skillId String

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)
}

model CandidateSkill {
  id                 String @id @default(cuid())
  candidateProfileId String
  skillId            String

  candidateProfile CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  skill            Skill            @relation(fields: [skillId], references: [id], onDelete: Cascade)
  evidence         SkillEvidence[]

  @@unique([candidateProfileId, skillId])
}

model Project {
  id                 String      @id @default(cuid())
  candidateProfileId String
  title              String
  description        String
  url                String?
  kind               ProjectKind

  candidateProfile CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  evidence         SkillEvidence[]
}

model SkillEvidence {
  candidateSkillId String
  projectId        String

  candidateSkill CandidateSkill @relation(fields: [candidateSkillId], references: [id], onDelete: Cascade)
  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([candidateSkillId, projectId])
}

// ---------- Employer side ----------

model Organization {
  id          String  @id @default(cuid())
  ownerUserId String  @unique
  name        String
  description String
  website     String?
  location    String

  owner User  @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  jobs  Job[]
}

model Job {
  id              String          @id @default(cuid())
  organizationId  String
  title           String
  description     String
  experienceLevel ExperienceLevel
  jobType         JobType
  workArrangement WorkArrangement
  location        String
  deadline        DateTime?
  status          JobStatus       @default(DRAFT)
  createdAt       DateTime        @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  skills       JobSkill[]
  applications Application[]
  reports      Report[]

  @@index([status])
  @@index([experienceLevel])
  @@index([jobType])
  @@index([workArrangement])
  @@index([location])
}

model JobSkill {
  jobId   String
  skillId String

  job   Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([jobId, skillId])
  @@index([skillId])
}

// ---------- Applications ----------

model Application {
  id                 String            @id @default(cuid())
  jobId              String
  candidateProfileId String
  coverNote          String?
  status             ApplicationStatus @default(SUBMITTED)
  createdAt          DateTime          @default(now())

  job              Job                        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateProfile CandidateProfile           @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  statusHistory    ApplicationStatusHistory[]

  @@unique([jobId, candidateProfileId])
}

model ApplicationStatusHistory {
  id              String            @id @default(cuid())
  applicationId   String
  status          ApplicationStatus
  changedByUserId String
  changedAt       DateTime          @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  changedBy   User        @relation(fields: [changedByUserId], references: [id], onDelete: Restrict)
}

// ---------- Reports ----------

model Report {
  id               String         @id @default(cuid())
  jobId            String
  reporterUserId   String
  reason           String
  details          String?
  status           ReportStatus   @default(OPEN)
  outcome          ReportOutcome?
  adminNote        String?
  reviewedByUserId String?
  createdAt        DateTime       @default(now())

  job        Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  reporter   User  @relation("ReportReporter", fields: [reporterUserId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("ReportReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
}
